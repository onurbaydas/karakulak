// Karakulak shows no password dialogs outside the browser, so the admin
// sitting at the machine may change these settings without one. Nothing else.
polkit.addRule(function (action, subject) {
    if (!subject.local || !subject.active || !subject.isInGroup("sudo")) {
        return polkit.Result.NOT_HANDLED;
    }
    switch (action.id) {
    case "org.freedesktop.locale1.set-locale":
    case "org.freedesktop.locale1.set-keyboard":
    case "org.freedesktop.timedate1.set-timezone":
        return polkit.Result.YES;
    case "org.freedesktop.systemd1.manage-units":
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        if (unit == "karakulak-update.service" && verb == "start") {
            return polkit.Result.YES;
        }
        if (unit == "nftables.service" && (verb == "start" || verb == "stop")) {
            return polkit.Result.YES;
        }
    }
    return polkit.Result.NOT_HANDLED;
});
