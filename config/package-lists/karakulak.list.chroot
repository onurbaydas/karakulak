# Boot splash
plymouth
plymouth-themes

# Session (karakulak-compositor and its libraries)
firefox
libseat1
libinput10
libgbm1
libdisplay-info2
libxkbcommon0
libegl1
libgles2
dmz-cursor-theme
libpam-systemd
dbus-user-session

# Screen sharing in Firefox: the portal asks the compositor for frames
xdg-desktop-portal
xdg-desktop-portal-wlr

# Graphics and fonts
libgl1-mesa-dri
fonts-noto-core
fonts-noto-color-emoji

# Sound and Bluetooth
pipewire-audio
pulseaudio-utils
bluez

# Power modes (Performance / Balanced / Power saver)
power-profiles-daemon

# Files: USB sticks, trash
udisks2
pciutils

# System settings: languages, updates, firewall
locales
unattended-upgrades
nftables
tor
firefox-l10n-tr

# Printing (driverless printers work without extra drivers)
cups
cups-filters
ipp-usb

# Network
network-manager
wpasupplicant
ca-certificates

# Firmware: Wi-Fi and sound on most laptops need these
firmware-linux-free
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-sof-signed

# Recommended by the packages above, but needed (the image skips recommends)
polkitd
sudo
keyboard-configuration
iproute2
systemd-timesyncd
xdg-user-dirs
libavcodec61
