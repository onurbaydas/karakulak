#!/bin/sh
set -e

lb config noauto \
	--distribution trixie \
	--archive-areas "main contrib non-free non-free-firmware" \
	--debootstrap-options "--include=ca-certificates" \
	--debian-installer live \
	--debian-installer-gui false \
	--iso-application "Karakulak" \
	--iso-volume "KARAKULAK" \
	--bootappend-live "boot=live components quiet splash username=karakulak hostname=karakulak locales=tr_TR.UTF-8 keyboard-layouts=tr" \
	"${@}"
