{
  "manifest_version": 3,
  "name": "Karakulak Panel",
  "version": "0.17.0",
  "description": "System panel for Karakulak: clock, battery, sound, brightness, Wi-Fi, Bluetooth and power.",
  "browser_specific_settings": {
    "gecko": {
      "id": "panel@karakulak",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "clipboardRead",
    "clipboardWrite",
    "topSites",
    "search"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Karakulak",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon.svg"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  }
}
